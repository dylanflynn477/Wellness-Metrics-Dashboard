# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
work/
outputs/

# Local environment and generated databases
.env
*.db

# Local health exports contain private data. Keep placeholders, not raw files.
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

# Processed outputs may be generated from private data.
data/processed/**
!data/processed/
!data/processed/.gitkeep

# Power BI and local analysis artifacts
dashboard/*.pbix
dashboard/*.pbit
# PBIP caches and local settings can embed imported data or machine-specific paths.
**/.pbi/
notebooks/.ipynb_checkpoints/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
