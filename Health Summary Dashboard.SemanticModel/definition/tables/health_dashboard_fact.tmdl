	column alcohol_consumption_count
		dataType: int64
		formatString: 0
		lineageTag: b22c77b5-7d73-4ad6-8135-ac20e6af0d44
		summarizeBy: sum
		sourceColumn: alcohol_consumption_count

		annotation SummarizationSetBy = Automatic

	column 'Drink Bucket' =
			VAR Drinks =
				health_dashboard_fact[alcohol_consumption_count]
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( Drinks ), "Unknown",
					Drinks <= 0, "0 drinks",
					Drinks = 1, "1 drink",
					Drinks = 2, "2 drinks",
					"3+ drinks"
				)
		lineageTag: 5c750868-a40a-44ad-8223-7b6adca761ce
		summarizeBy: none
		sortByColumn: 'Drink Bucket Sort'

		annotation SummarizationSetBy = User

	column 'Drink Bucket Sort' =
			VAR Drinks =
				health_dashboard_fact[alcohol_consumption_count]
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( Drinks ), 0,
					Drinks <= 0, 1,
					Drinks = 1, 2,
					Drinks = 2, 3,
					Drinks >= 3, 4,
					0
				)
		formatString: 0
		lineageTag: f758882a-1f5b-40f5-8c39-a4f557b36961
		summarizeBy: sum

		annotation SummarizationSetBy = User

	column 'Next Day Workout Minutes' =
			VAR Tomorrow =
				health_dashboard_fact[date] + 1
			RETURN
				LOOKUPVALUE (
					health_dashboard_fact[workout_minutes],
					health_dashboard_fact[date], Tomorrow
				)
		description: Metric from date + 1 for descriptive lifestyle comparisons; not causal.
		lineageTag: 7264c64d-bc73-441f-b79e-7d388db55b06
		summarizeBy: average

		annotation SummarizationSetBy = User

