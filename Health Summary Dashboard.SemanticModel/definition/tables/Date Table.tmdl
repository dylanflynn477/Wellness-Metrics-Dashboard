	measure 'Sleep 7D' =
			
			VAR EndDate =
			    MAX ( 'Date Table'[Date] )
			RETURN
			    CALCULATE (
			        [Avg Sleep],
			        FILTER (
			            ALL ( 'Date Table'[Date] ),
			            'Date Table'[Date] >= EndDate - 6
			                && 'Date Table'[Date] <= EndDate
			        )
			    )
