	column 'Week Index' =
			
			VAR FirstWeek =
			    MINX (
			        ALL ( 'Date Table' ),
			        'Date Table'[Week Start]
			    )
			RETURN
			    DATEDIFF (
			        FirstWeek,
			        'Date Table'[Week Start],
			        WEEK
			    )
		formatString: 0
		lineageTag: ca134335-60eb-4ffd-8e1b-4f96a9dac9ce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

