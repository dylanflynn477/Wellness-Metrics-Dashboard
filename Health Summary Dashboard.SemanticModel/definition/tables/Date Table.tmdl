	measure 'Next-Day Workout Average' =
			CALCULATE (
				AVERAGE (
					health_dashboard_fact[Next Day Workout Minutes]
				),
				KEEPFILTERS (
					health_dashboard_fact[Next Day Has Imputed Values] = 0
				)
			)
		formatString: 0 "minutes"
		lineageTag: 78f541b6-129c-4859-8e8d-f0de72bf62e7

	measure 'Next-Day Workout N' =
			CALCULATE (
				COUNT (
					health_dashboard_fact[Next Day Workout Minutes]
				),
				KEEPFILTERS (
					health_dashboard_fact[Next Day Has Imputed Values] = 0
				)
			)
		formatString: 0
		lineageTag: 6f8fb911-fdc8-4b2f-a758-2835296de473

	measure 'Next-Day Workout SD' =
			CALCULATE (
				STDEV.S (
					health_dashboard_fact[Next Day Workout Minutes]
				),
				KEEPFILTERS (
					health_dashboard_fact[Next Day Has Imputed Values] = 0
				)
			)
		formatString: 0 "minutes"
		lineageTag: 3cb68bde-14bb-439b-872a-023932709d73

	measure 'Next-Day Workout CI Half Width' =
			VAR N =
				[Next-Day Workout N]
			RETURN
				IF (
					N >= 2,
					1.96
						* DIVIDE (
							[Next-Day Workout SD],
							SQRT ( N )
						)
				)
		formatString: 0 "minutes"
		lineageTag: c6626e56-1799-4d67-8a7e-9cd2ef18ff2f

	measure 'Next-Day Workout CI Low' =
			[Next-Day Workout Average]
				- [Next-Day Workout CI Half Width]
		formatString: 0 "minutes"
		lineageTag: 7118f0b1-4d28-477e-9001-e5dc1f95bbac

	measure 'Next-Day Workout CI High' =
			[Next-Day Workout Average]
				+ [Next-Day Workout CI Half Width]
		formatString: 0 "minutes"
		lineageTag: e5884180-37ae-4eb7-a180-ad0251e9a30c

	measure 'Next-Day Active Energy Delta 3+' =
			
			VAR SelectedDrinkDates =
			    VALUES(
			        'health_dashboard_fact'[date]
			    )
			
			VAR HeavyDrinkDates =
			    FILTER(
			        SelectedDrinkDates,
			        CALCULATE(
			            MAX(
			                'health_dashboard_fact'[alcohol_consumption_count]
			            )
			        ) >= 3
			    )
			
			VAR SoberDates =
			    FILTER(
			        SelectedDrinkDates,
			        CALCULATE(
			            MAX(
			                'health_dashboard_fact'[alcohol_consumption_count]
			            )
			        ) = 0
			    )
			
			VAR HeavyDrinkAverage =
			    AVERAGEX(
			        HeavyDrinkDates,
			        VAR DrinkDate =
			            'health_dashboard_fact'[date]
			
			        RETURN
			            CALCULATE(
			                MAX(
			                    'health_dashboard_fact'[active_energy_kcal]
			                ),
			                REMOVEFILTERS('Date Table'),
			                REMOVEFILTERS('health_dashboard_fact'),
			                'health_dashboard_fact'[date] = DrinkDate + 1
			            )
			    )
			
			VAR SoberAverage =
			    AVERAGEX(
			        SoberDates,
			        VAR DrinkDate =
			            'health_dashboard_fact'[date]
			
			        RETURN
			            CALCULATE(
			                MAX(
			                    'health_dashboard_fact'[active_energy_kcal]
			                ),
			                REMOVEFILTERS('Date Table'),
			                REMOVEFILTERS('health_dashboard_fact'),
			                'health_dashboard_fact'[date] = DrinkDate + 1
			            )
			    )
			
			RETURN
			    HeavyDrinkAverage - SoberAverage
		lineageTag: 9d68b066-41cb-4240-a38f-3b5a14730081

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Next-Day Workout Delta 3+' =
			
			VAR SelectedDrinkDates =
			    VALUES(
			        'health_dashboard_fact'[date]
			    )
			
			VAR HeavyDrinkDates =
			    FILTER(
			        SelectedDrinkDates,
			        CALCULATE(
			            MAX(
			                'health_dashboard_fact'[alcohol_consumption_count]
			            )
			        ) >= 3
			    )
			
			VAR SoberDates =
			    FILTER(
			        SelectedDrinkDates,
			        CALCULATE(
			            MAX(
			                'health_dashboard_fact'[alcohol_consumption_count]
			            )
			        ) = 0
			    )
			
			VAR HeavyDrinkAverage =
			    AVERAGEX(
			        HeavyDrinkDates,
			        VAR DrinkDate =
			            'health_dashboard_fact'[date]
			
			        RETURN
			            CALCULATE(
			                MAX(
			                    'health_dashboard_fact'[workout_minutes]
			                ),
			                REMOVEFILTERS('Date Table'),
			                REMOVEFILTERS('health_dashboard_fact'),
			                'health_dashboard_fact'[date] = DrinkDate + 1
			            )
			    )
			
			VAR SoberAverage =
			    AVERAGEX(
			        SoberDates,
			        VAR DrinkDate =
			            'health_dashboard_fact'[date]
			
			        RETURN
			            CALCULATE(
			                MAX(
			                    'health_dashboard_fact'[workout_minutes]
			                ),
			                REMOVEFILTERS('Date Table'),
			                REMOVEFILTERS('health_dashboard_fact'),
			                'health_dashboard_fact'[date] = DrinkDate + 1
			            )
			    )
			
			RETURN
			    HeavyDrinkAverage - SoberAverage
		lineageTag: 1c4a83b0-6fa9-4876-8630-9b68f12c95fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Calories Valid Days' =
			
			AVERAGEX (
			    FILTER (
			        VALUES ( 'Date Table'[Date] ),
			        CALCULATE (
			            MAX ( health_dashboard_fact[calories] )
			        ) >= 1200
			    ),
			    CALCULATE (
			        MAX ( health_dashboard_fact[calories] )
			    )
			)
