			VAR WindowDates =
				FILTER (
					ALL ( 'Date Table'[Date] ),
					'Date Table'[Date] >= EndDate - 6
						&& 'Date Table'[Date] <= EndDate
				)
			RETURN
				AVERAGEX (
					FILTER (
						WindowDates,
						CALCULATE (
							MAX (
								health_dashboard_fact[calories]
							)
						) >= 1200
					),
					CALCULATE (
						MAX (
