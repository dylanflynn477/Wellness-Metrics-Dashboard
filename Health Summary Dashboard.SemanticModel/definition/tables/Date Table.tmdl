	measure 'Usable Next-Day Workout Observations' =
			CALCULATE (
				COUNT (
					health_dashboard_fact[Next Day Workout Minutes]
				),
				KEEPFILTERS (
					health_dashboard_fact[Next Day Has Imputed Values] = 0
				)
