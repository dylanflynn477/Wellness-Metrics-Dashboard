	measure 'Current Weight (Selected)' =
			
			VAR LastDateWithWeight =
			    MAXX(
			        FILTER(
			            ALLSELECTED(health_dashboard_fact[date]),
			            NOT ISBLANK(
			                CALCULATE(
			                    MAX(health_dashboard_fact[weight_7d_avg])
			                )
			            )
			        ),
			        health_dashboard_fact[date]
			    )
			RETURN
			    CALCULATE(
			        MAX(health_dashboard_fact[weight_7d_avg]),
			        health_dashboard_fact[date] = LastDateWithWeight
			    )
		lineageTag: cdaa1db6-6b13-4c2b-b4ed-7993c0353010

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Weight (Selected)' =
			
			MAXX(
			    ALLSELECTED(health_dashboard_fact[date]),
			    CALCULATE(
			        MAX(health_dashboard_fact[weight_7d_avg])
			    )
			)
		lineageTag: ec9b8faf-a8a4-4dde-b4ab-0eb75fdcbdb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Down From Peak' =
			
			[Peak Recorded Weight]
			    - [Latest Recorded Weight]
		lineageTag: 011b6c11-58df-4ddf-9a01-4a06b4fd8f46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weight Change vs Previous' =
			
			VAR LastDateWithWeight =
			    MAXX(
			        FILTER(
			            ALLSELECTED(health_dashboard_fact[date]),
			            NOT ISBLANK(
			                CALCULATE(MAX(health_dashboard_fact[weight_7d_avg]))
			            )
			        ),
			        health_dashboard_fact[date]
			    )
			VAR PrevDateWithWeight =
			    MAXX(
			        FILTER(
			            ALLSELECTED(health_dashboard_fact[date]),
			            health_dashboard_fact[date] < LastDateWithWeight &&
			            NOT ISBLANK(
			                CALCULATE(MAX(health_dashboard_fact[weight_7d_avg]))
			            )
			        ),
			        health_dashboard_fact[date]
			    )
			VAR CurrentWeight =
			    CALCULATE(
			        MAX(health_dashboard_fact[weight_7d_avg]),
			        health_dashboard_fact[date] = LastDateWithWeight
			    )
			VAR PrevWeight =
			    CALCULATE(
			        MAX(health_dashboard_fact[weight_7d_avg]),
			        health_dashboard_fact[date] = PrevDateWithWeight
			    )
			RETURN
			    CurrentWeight - PrevWeight
		lineageTag: 3fffb3ad-1c46-4bdc-a8e9-932e15c87120

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weight Change Color' =
			
			SWITCH(
			    TRUE(),
			    [Weight Change vs Previous] < 0, "#4ADE80",
			    [Weight Change vs Previous] > 0, "#EF4444",
			    "#FFFFFF"
			)
		lineageTag: cff254fd-7fda-4a23-9bb9-cb0fd5624600

	measure 'Current Weight (Period)' =
			
			VAR VisibleDates =
			    ALLSELECTED('Date Table'[Date])
			
			VAR LastVisibleWeightDate =
			    MAXX(
			        FILTER(
			            VisibleDates,
			            NOT ISBLANK(
			                CALCULATE(
			                    MAX(health_dashboard_fact[weight_7d_avg])
			                )
			            )
			        ),
			        'Date Table'[Date]
			    )
			
			RETURN
			    CALCULATE(
			        MAX(health_dashboard_fact[weight_7d_avg]),
			        KEEPFILTERS(
			            'Date Table'[Date] = LastVisibleWeightDate
			        )
			    )
		lineageTag: 7df747a2-84e6-4416-b2df-90a95e31e954

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Weight (Period)' =
			
			MAXX(
