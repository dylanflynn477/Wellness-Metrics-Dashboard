		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Weight Change (Period)' =
			
			[Current Weight (Period)] - [Starting Weight (Period)]
		lineageTag: 029904bd-ff46-4887-851d-d37a71207879

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Weight Change Color' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK([Net Weight Change (Period)]), "#94A3B8",
			    [Net Weight Change (Period)] < 0, "#4ADE80",
			    [Net Weight Change (Period)] > 0, "#F87171",
			    "#CBD5E1"
			)
		lineageTag: 4a64d0e5-100c-48ae-85b9-d767ea915505

	measure 'Selected Days' =
