		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Starting Weight (Period)' =
			
			VAR VisibleDates =
			    ALLSELECTED('Date Table'[Date])
			
			VAR FirstVisibleWeightDate =
			    MINX(
			        FILTER(
			            VisibleDates,
			            NOT ISBLANK(
			                CALCULATE(
			                    MAX(health_dashboard_fact[weight_7d_avg])
			                )
			            )
