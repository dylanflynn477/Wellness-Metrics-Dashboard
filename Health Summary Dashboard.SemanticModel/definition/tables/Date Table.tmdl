	measure 'Calorie Target' =
			
			AVERAGEX (
			    FILTER (
			        health_dashboard_fact,
			        NOT ISBLANK (
			            health_dashboard_fact[calorie_delta_from_target]
			        )
			    ),
			    health_dashboard_fact[calories]
			        - health_dashboard_fact[calorie_delta_from_target]
			)
		formatString: 0
		lineageTag: bcf20b78-136e-4282-a0c0-dfaca204d521

	measure 'Protein Target' =
			
			AVERAGEX (
			    FILTER (
			        health_dashboard_fact,
			        NOT ISBLANK (
			            health_dashboard_fact[protein_delta_from_target]
			        )
			    ),
			    health_dashboard_fact[protein_g]
			        - health_dashboard_fact[protein_delta_from_target]
			)
		formatString: 0
		lineageTag: 7911a928-bf1a-4ed7-a0c6-b06b8019e9ac

	measure 'Logged Nutrition Days' =
			
			CALCULATE(
			    COUNTROWS(health_dashboard_fact),
			    NOT ISBLANK(health_dashboard_fact[calories])
			)
		formatString: 0
		lineageTag: 47a6d0a8-b7aa-48c0-898b-6ab7596fa56e

	measure 'Protein Hit Days' =
			
			SUMX (
			    VALUES ( 'Date Table'[Date] ),
			    VAR Calories =
			        CALCULATE (
			            MAX ( health_dashboard_fact[calories] )
			        )
			    VAR Protein =
			        CALCULATE (
			            MAX ( health_dashboard_fact[protein_g] )
			        )
			    VAR Target =
			        CALCULATE ( [Protein Target] )
			    RETURN
			        IF (
			            Calories >= 1200
			                && NOT ISBLANK ( Protein )
			                && Protein >= Target,
			            1,
			            0
			        )
			)
		formatString: 0
		lineageTag: a7004b77-1eb9-4502-843e-0dd6f239b80e

	measure 'Protein Adherence %' =
			
			DIVIDE (
			    [Protein Hit Days],
			    [Valid Nutrition Days]
			)
		formatString: 0%;-0%;0%
		lineageTag: 68568047-147f-4e49-b3aa-1dcc3ea10769

	measure 'Latest Recorded Weight' =
			
			VAR LastWeightDate =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( 'Date Table'[Date] ),
			            CALCULATE (
			                MAX (
			                    health_dashboard_fact[weight_measurement_flag]
			                )
			            ) = 1
			                && NOT ISBLANK (
			                    CALCULATE (
			                        MAX (
			                            health_dashboard_fact[weight_lb]
			                        )
			                    )
			                )
			        ),
			        'Date Table'[Date]
			    )
			RETURN
			    CALCULATE (
			        MAX ( health_dashboard_fact[weight_lb] ),
			        'Date Table'[Date] = LastWeightDate
			    )
		lineageTag: 24572ce0-e173-4c41-9ce8-b7dc2d91a6ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valid Nutrition Days' =
			
			SUMX (
			    VALUES ( 'Date Table'[Date] ),
			    VAR Calories =
			        CALCULATE (
			            MAX ( health_dashboard_fact[calories] )
			        )
			    RETURN
			        IF (
			            NOT ISBLANK ( Calories )
			                && Calories >= 1200,
			            1,
			            0
			        )
			)
		formatString: 0
		lineageTag: 0b3b2278-9901-43ab-9fc5-6f73c352f4a2

	measure 'Valid Nutrition Days 28D' =
			VAR EndDate =
				MAX ( 'Date Table'[Date] )
			RETURN
				CALCULATE (
					[Valid Nutrition Days],
					FILTER (
						ALL ( 'Date Table'[Date] ),
						'Date Table'[Date] >= EndDate - 27
							&& 'Date Table'[Date] <= EndDate
					)
				)
		formatString: 0
		lineageTag: 5c065b67-1aaa-43fe-ac0c-24cec150aa7b

	measure 'Protein Hit Days 28D' =
			VAR EndDate =
				MAX ( 'Date Table'[Date] )
			RETURN
				CALCULATE (
					[Protein Hit Days],
					FILTER (
						ALL ( 'Date Table'[Date] ),
						'Date Table'[Date] >= EndDate - 27
							&& 'Date Table'[Date] <= EndDate
					)
				)
		formatString: 0
		lineageTag: ca03b3eb-b1e5-49a0-9aaf-bec0133250f0

	measure 'Protein Adherence 28D %' =
			DIVIDE (
				[Protein Hit Days 28D],
				[Valid Nutrition Days 28D]
			)
		formatString: 0%
		lineageTag: 63373fef-7db5-421f-8be3-1608f21005ad

	measure 'Calories 7D Valid' =
			VAR EndDate =
				MAX ( 'Date Table'[Date] )
			VAR WindowDates =
				FILTER (
					ALL ( 'Date Table'[Date] ),
					'Date Table'[Date] >= EndDate - 6
						&& 'Date Table'[Date] <= EndDate
				)
			RETURN
				AVERAGEX (
					FILTER (
						WindowDates,
						CALCULATE (
							MAX (
								health_dashboard_fact[calories]
							)
						) >= 1200
					),
					CALCULATE (
						MAX (
							health_dashboard_fact[calories]
						)
					)
				)
		formatString: 0 "kcal"
		lineageTag: 6255677c-8d1f-49c9-8ba5-edf02496fd2b

	measure 'Protein 7D Valid' =
			VAR EndDate =
