	measure 'Drinking Days' =
			
			CALCULATE (
				DISTINCTCOUNT (
					health_dashboard_fact[date]
				),
				KEEPFILTERS (
					health_dashboard_fact[alcohol_consumption_count] > 0
				)
			)
		formatString: 0
		lineageTag: 5520c022-3af8-40b7-844a-e38884d6d52a

	measure 'Drinking Day %' =
			DIVIDE (
				[Drinking Days],
				[Selected Days]
			)
		formatString: 0%
		lineageTag: 4ded9b52-f274-4fd1-a135-37cb69b242c5

	measure 'Avg Drinks on Drinking Day' =
			
			CALCULATE (
				AVERAGE (
					health_dashboard_fact[alcohol_consumption_count]
				),
				KEEPFILTERS (
